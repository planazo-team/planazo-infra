# Variables compartidas por los servicios de Planazo al correr con docker compose (profile "app").
# Copia este archivo a `.env` (que está en .gitignore) y ajusta los valores.
#
# Genera cada secreto con:   openssl rand -hex 32
# (en Git Bash de Windows `openssl` viene incluido).

# Secreto con el que el gateway firma los JWT y con el que game y realtime los verifican.
# Lo comparten EXACTAMENTE: api-gateway, game, realtime.
JWT_SECRET=cambia-esto-por-el-resultado-de-openssl-rand-hex-32

# Clave que el gateway manda en el header `x-gateway-key` a booking, promo y game (HTTP).
# Esos servicios rechazan cualquier petición que no la traiga. La comparten: api-gateway, booking, promo, game.
GATEWAY_KEY=cambia-esto-por-otro-openssl-rand-hex-32

# Clave de Anthropic para el módulo `agent` (POST /api/plan). Si queda vacía,
# /plan responde con una plantilla sobre el catálogo en vez de llamar al modelo.
ANTHROPIC_API_KEY=

# Orígenes permitidos por CORS en el gateway (separados por coma). En local, el frontend de Next.js.
ALLOWED_ORIGINS=http://localhost:3000
