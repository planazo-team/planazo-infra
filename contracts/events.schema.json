            "finished"
          ]
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GamePlayer"
          }
        }
      }
    },
    "LeaderEntry": {
      "description": "types.ts → LeaderEntry.",
      "type": "object",
      "required": [
        "playerId",
        "name",
        "score"
      ],
      "properties": {
        "playerId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PlaceUpdatePayload": {
      "description": "types.ts → PlaceUpdatePayload. booking → zone:<zona>, place:<id>. El mapa actualiza `freeSeats` (RT-1).",
      "type": "object",
      "required": [
        "placeId",
        "freeSeats"
      ],
      "properties": {
        "placeId": {
          "type": "string"
        },
        "freeSeats": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "InvUpdatePayload": {
      "description": "types.ts → InvUpdatePayload. booking → place:<id>. La ficha y el panel reemplazan la franja completa.",
