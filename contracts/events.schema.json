    "Coupon": {
      "description": "types.ts → Coupon.",
      "type": "object",
      "required": [
        "id",
        "promoId",
        "code",
        "title",
        "discount",
        "placeName",
        "claimedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "promoId": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "discount": {
          "type": "string"
        },
        "placeName": {
          "type": "string"
        },
        "claimedAt": {
          "$ref": "#/definitions/EpochMs"
        }
      }
    },
    "GamePlayer": {
      "description": "types.ts → GamePlayer.",
      "type": "object",
      "required": [
        "id",
        "name",
        "color",
        "alive",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "alive": {
          "type": "boolean"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "isBot": {
          "type": "boolean"
        }
      }
    },
    "Room": {
      "description": "types.ts → Room.",
      "type": "object",
      "required": [
        "code",
        "hostId",
        "status",
        "players"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
