    },
    "PromoWonPayload": {
      "description": "promo → zone:<zona>, place:<id> (y user:<userId> del ganador). El frontend lee `promoId`, `stock` (restante) y `winner` (nombre). El Coupon completo lo recibe el ganador en la respuesta HTTP del claim, no aquí.",
      "type": "object",
      "required": [
        "promoId",
        "placeId",
        "stock",
        "winner"
      ],
      "properties": {
        "promoId": {
          "type": "string"
        },
        "placeId": {
          "type": "string"
        },
        "stock": {
          "type": "integer",
          "minimum": 0
        },
        "winner": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "coupon": {
          "$ref": "#/definitions/Coupon"
        }
      }
    },
    "PromoRejectedPayload": {
      "description": "promo → user:<userId>, place:<id>. Aún no lo consume el frontend; forma propuesta.",
      "type": "object",
      "required": [
        "promoId",
        "placeId",
        "userId",
        "code"
      ],
      "properties": {
        "promoId": {
          "type": "string"
        },
        "placeId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "enum": [
            "PROMO_AGOTADA",
            "PROMO_VENCIDA"
          ]
        }
      }
    },
    "PromoExpiredPayload": {
