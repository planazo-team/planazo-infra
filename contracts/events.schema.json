    "RtEvent": {
      "description": "Lo que realtime entrega al cliente en `{ type:'EVENT', event }` y `{ type:'REPLAY', events }`: el sobre más `seq`, asignado por realtime al persistir (orden global, permite RESUME).",
      "type": "object",
      "required": [
        "seq",
        "id",
