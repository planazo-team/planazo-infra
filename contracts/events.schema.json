{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/planazo-team/planazo-infra/contracts/events.schema.json",
  "title": "Sobre de evento de dominio de Planazo",
  "description": "Lo que booking, promo y game (Java) publican al canal Redis `planazo.events`. NO lleva `seq`: ese campo lo asigna `realtime` al persistir el evento en su tabla `events` (BIGSERIAL) y solo aparece en lo que el cliente recibe como `RtEvent { seq, id, type, payload, topics, at }`. Los payloads siguen exactamente lo que el frontend consume en sus `useRtEvent<T>` (planazo-frontend/frontend/src/lib/types.ts y las páginas que lo usan).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "topics",
    "payload",
    "at"
  ],
  "properties": {
    "id": {
      "description": "UUID único del evento. Permite al cliente descartar duplicados en una reentrega (RT-2).",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "description": "EventType de types.ts más los que emiten los servicios y el frontend aún no consume. ROOM.JOIN, SNAKE.* y ROUND.END son del diseño anterior del juego; game (Java) publica GAME.STATE_UPDATE, LOBBY.ROOMS_UPDATE y GAME.PARTIDA_FINALIZADA.",
      "type": "string",
      "enum": [
        "PLACE.UPDATE",
        "INV.UPDATE",
        "RESERVE.OK",
        "RESERVE.CONFLICT",
        "PROMO.PUSH",
        "PROMO.WON",
        "PROMO.REJECTED",
        "PROMO.EXPIRED",
        "ROOM.JOIN",
        "SNAKE.SCORE",
        "SNAKE.DEATH",
        "ROUND.END",
        "GAME.STATE_UPDATE",
        "LOBBY.ROOMS_UPDATE",
        "GAME.PARTIDA_FINALIZADA"
      ]
    },
    "topics": {
      "description": "A quién se enruta: zone:zona-g, place:p7, user:u1, salas, salas:sala-004, global (room:ABCD era del diseño anterior). Un evento puede ir a varios.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^((zone|place|user|room|salas):|salas$|global$)"
      }
    },
    "payload": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "at": {
      "description": "Momento de emisión, epoch en milisegundos.",
      "type": "integer",
      "minimum": 0
    },
    "emittedAt": {
      "description": "Opcional. Instante (epoch ms) en que el servicio emisor publica en el bus; hoy vale lo mismo que `at`. Realtime reemplaza `at` por el momento en que persiste el evento, pero entrega `emittedAt` intacto en los EVENT en vivo: con él se mide la latencia publicación → entrega (ESC-06, k6/esc06-latencia-tiempo-real.js).",
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "PLACE.UPDATE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/PlaceUpdatePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "INV.UPDATE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/InvUpdatePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RESERVE.OK"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/ReserveOkPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RESERVE.CONFLICT"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/ReserveConflictPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PROMO.PUSH"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/PromoPushPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PROMO.WON"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/PromoWonPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PROMO.REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/PromoRejectedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PROMO.EXPIRED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/PromoExpiredPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ROOM.JOIN"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/RoomJoinPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SNAKE.SCORE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/SnakeScorePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SNAKE.DEATH"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/SnakeDeathPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ROUND.END"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/RoundEndPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "GAME.STATE_UPDATE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/GameStateUpdatePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "LOBBY.ROOMS_UPDATE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/LobbyRoomsUpdatePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "GAME.PARTIDA_FINALIZADA"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/GamePartidaFinalizadaPayload"
          }
        }
      }
    }
  ],
  "definitions": {
    "Zone": {
      "type": "string",
      "enum": [
        "zona-g",
        "zona-t"
      ]
    },
    "EpochMs": {
      "type": "integer",
      "minimum": 0
    },
    "Slot": {
      "description": "types.ts → Slot. `version` es la clave del lock optimista (CC-3).",
      "type": "object",
      "required": [
        "id",
        "placeId",
        "startsAt",
        "capacity",
        "taken",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "placeId": {
          "type": "string"
        },
        "startsAt": {
          "type": "string"
        },
        "capacity": {
          "type": "integer",
          "minimum": 0
        },
        "taken": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Reservation": {
      "description": "types.ts → Reservation.",
      "type": "object",
      "required": [
        "id",
        "slotId",
        "placeId",
        "placeName",
        "startsAt",
        "people",
        "code",
        "userId",
        "userName",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "slotId": {
          "type": "string"
        },
        "placeId": {
          "type": "string"
        },
        "placeName": {
          "type": "string"
        },
        "startsAt": {
          "type": "string"
        },
        "people": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "userName": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/definitions/EpochMs"
        }
      }
    },
    "Promo": {
      "description": "types.ts → Promo.",
      "type": "object",
      "required": [
        "id",
        "placeId",
        "placeName",
        "zone",
        "title",
        "discount",
        "stock",
        "initialStock",
        "expiresAt"
