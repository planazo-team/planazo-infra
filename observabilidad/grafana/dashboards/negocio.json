{
  "uid": "planazo-negocio",
  "title": "Planazo · Negocio",
  "description": "KPIs del business case: usuarios, sesiones, reservas por zona, cupones, partidas, agente y uso de la app (HU-133). Filtra por zona y por tiempo.",
  "tags": [
    "planazo"
  ],
  "timezone": "America/Bogota",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "zona",
        "label": "Zona",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(planazo_reservas_total, zona)",
          "refId": "zona"
        },
        "definition": "label_values(planazo_reservas_total, zona)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
