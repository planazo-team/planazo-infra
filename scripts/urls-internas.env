# URLs de la red privada de Railway que usa railway-deploy-core.sh.
# La red privada (*.railway.internal) va cifrada por WireGuard entre contenedores;
# dentro de ella los servicios se hablan por HTTP plano.
BOOKING_URL_INTERNA=http://planazo-booking.railway.internal:3001
PROMO_URL_INTERNA=http://planazo-promo.railway.internal:3002
GAME_URL_INTERNA=http://planazo-game.railway.internal:8082
FRONTEND_LOCAL=http://localhost:3000
